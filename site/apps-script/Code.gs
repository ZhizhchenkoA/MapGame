const GRAPH = {"35":[36,34,22,18,37],"27":[6,29,28,5,4,26],"6":[27,30,11,29,8,5,1,9,10],"40":[42,41,28,39,26],"30":[6,42,43,36,32,11,29,28],"42":[40,30,43,41,36,28],"43":[30,42,36],"41":[40,42,36,39,37],"36":[35,30,42,43,41,34,32,37],"34":[35,36,32,33,16,14,18],"32":[30,36,34,31,33,11,13,14],"12":[11,10,13,14],"31":[32,11,13],"2":[3,1,4,26,25],"33":[34,32,16,14],"16":[34,33,17,19,14,18],"17":[16,19,15,14],"3":[2,4,26],"11":[6,30,32,12,31,9,10,13],"7":[8,1],"29":[27,6,30,28],"28":[27,40,30,42,29,26],"19":[16,17,20,18],"8":[6,7,1,10],"5":[27,6,1,4],"1":[6,2,7,8,5,4],"4":[27,2,3,5,1,26],"9":[6,11,10],"10":[6,12,11,8,9],"15":[17,14],"13":[32,12,31,11,14],"14":[34,32,12,33,16,17,15,13],"24":[22,25,23],"22":[35,24,21,18,37,23],"21":[22,20,18],"20":[19,21,18],"18":[35,34,16,19,22,21,20],"39":[40,41,26,25,37,38],"26":[27,40,2,3,28,4,39,25],"25":[2,24,39,26,23,38],"37":[35,41,36,22,39,23,38],"23":[24,22,25,37,38],"38":[39,25,37,23]};
// One spreadsheet, many match sheets. Run setup() once after setting JURY_PIN in Script Properties.
const INDEX='Games', EVENTS='Events';
function setup(){const ss=SpreadsheetApp.getActiveSpreadsheet();if(!ss.getSheetByName(INDEX)){const sh=ss.insertSheet(INDEX);sh.appendRow(['Game','Team 1','Team 2','Created']);}if(!ss.getSheetByName(EVENTS)){ss.insertSheet(EVENTS).appendRow(['Time','Game','Action','Team','Task','Score 1','Score 2']);}if(ss.getSheetByName(INDEX).getLastRow()===1){const old=ss.getSheetByName('State');let saved=null;try{if(old)saved=JSON.parse(old.getRange('A2').getValue())}catch(_){}const name=createGame('J1 vs J2',saved?.teams?.[0]?.name||'J1',saved?.teams?.[1]?.name||'J2');if(saved){saved.teams.forEach(t=>{t.results=t.results||{};t.attempts=t.attempts||{};t.hinted=t.hinted||[]});const target=ss.getSheetByName(name);target.getRange('A2').setValue(JSON.stringify(saved));writeBoard(target,saved)}}}
function createGame(name,n1,n2){const ss=SpreadsheetApp.getActiveSpreadsheet();name=String(name||'').trim();if(!name||name.length>70||/[\[\]*?/\\:]/.test(name)||[INDEX,EVENTS].includes(name))throw Error('Invalid game name');if(ss.getSheetByName(name))throw Error('Game already exists');const sh=ss.insertSheet(name);const state=initialState(n1,n2);sh.getRange('A1').setValue('Game state — do not edit A2');sh.getRange('A2').setValue(JSON.stringify(state));ss.getSheetByName(INDEX).appendRow([name,state.teams[0].name,state.teams[1].name,new Date()]);writeBoard(sh,state);return name}
function initialState(n1,n2){return {phase:'waiting',startedAt:null,teams:[{name:String(n1||'J1').slice(0,50),cards:[3],failed:[],hints:0,attempts:{},hinted:[],results:{}},{name:String(n2||'J2').slice(0,50),cards:[19],failed:[],hints:0,attempts:{},hinted:[],results:{}}],territories:Array.from({length:43},(_,i)=>({id:i+1,owner:0,blocked:false}))}}
function gameNames(){const sh=SpreadsheetApp.getActiveSpreadsheet().getSheetByName(INDEX);if(!sh)throw Error('Run setup()');return sh.getLastRow()<2?[]:sh.getRange(2,1,sh.getLastRow()-1,3).getValues().map(r=>({id:r[0],teams:[r[1],r[2]]}))}
function getGame(id){const games=gameNames();if(!id)id=games[0]?.id;if(!games.some(g=>g.id===id))throw Error('Unknown game');return {id,sheet:SpreadsheetApp.getActiveSpreadsheet().getSheetByName(id)}}
function loadState(sh){return JSON.parse(sh.getRange('A2').getValue())}
function points(n){return n===43?12:n<=27?5:8}
function score(s,i){return s.territories.filter(x=>x.owner===i+1).reduce((a,x)=>a+points(x.id),0)-2*s.teams[i].hints}
function adjacent(s,i){const t=s.teams[i],ids=new Set(s.territories.filter(x=>x.owner===i+1).flatMap(x=>GRAPH[x.id]||[]));return [...ids].filter(n=>{const x=s.territories[n-1];return !x.owner&&!x.blocked&&!t.cards.includes(n)&&!t.failed.includes(n)})}
function finishIfNeeded(s){if(s.phase==='active'&&(Date.now()-new Date(s.startedAt).getTime()>=5400000||s.teams.every((t,i)=>!t.cards.length&&!adjacent(s,i).length)))s.phase='finished'}
function response(data,cb){const json=JSON.stringify(data);return ContentService.createTextOutput(cb?cb+'('+json+')':json).setMimeType(cb?ContentService.MimeType.JAVASCRIPT:ContentService.MimeType.JSON)}
function doGet(e){const cb=String(e.parameter.callback||'').replace(/[^a-zA-Z0-9_$.]/g,'');try{if(e.parameter.action==='games')return response({games:gameNames()},cb);const g=getGame(e.parameter.game),s=loadState(g.sheet);finishIfNeeded(s);return response({game:g.id,games:gameNames(),...s},cb)}catch(err){return response({error:String(err)},cb)}}
function doPost(e){const lock=LockService.getScriptLock();lock.waitLock(20000);try{const p=e.parameter,secret=PropertiesService.getScriptProperties().getProperty('JURY_PIN');if(!secret||p.pin!==secret)throw Error('Invalid PIN');if(p.action==='create'){const name=createGame(p.name,p.team1,p.team2);return response({ok:true,game:name})}const g=getGame(p.game),s=loadState(g.sheet),action=p.action,id=Number(p.id),team=Number(p.team),i=team-1;finishIfNeeded(s);
if(action==='start'){if(s.phase!=='waiting')throw Error('Already started');s.phase='active';s.startedAt=new Date().toISOString()}
else{if(s.phase!=='active')throw Error('Game is not active');if(![1,2].includes(team)||!Number.isInteger(id)||id<1||id>43)throw Error('Invalid card');const t=s.teams[i],x=s.territories[id-1];if(action==='take'){if(t.cards.length>=3||!adjacent(s,i).includes(id))throw Error('Card unavailable');t.cards.push(id)}else{if(!t.cards.includes(id))throw Error('Card not held');if(action==='correct'){if(x.owner||x.blocked)throw Error('Already claimed');x.owner=team;t.results[id]=(t.results[id]||'')+'✓';t.cards=t.cards.filter(n=>n!==id);s.teams[1-i].cards=s.teams[1-i].cards.filter(n=>n!==id)}else if(action==='wrong'){t.attempts[id]=(t.attempts[id]||0)+1;t.results[id]=(t.results[id]||'')+'×';if(t.attempts[id]>=(id===[3,19][i]?3:2)){t.cards=t.cards.filter(n=>n!==id);t.failed.push(id)}}else if(action==='hint'){if(!(t.attempts[id]>0)||t.hinted.includes(id))throw Error('Hint unavailable');t.hinted.push(id);t.hints++}else if(action==='drop'){if(id===[3,19][i])throw Error('Start card cannot be dropped');t.cards=t.cards.filter(n=>n!==id);t.failed.push(id)}else throw Error('Unknown action')}if(!x.owner&&s.teams.every(z=>z.failed.includes(id)))x.blocked=true}
finishIfNeeded(s);g.sheet.getRange('A2').setValue(JSON.stringify(s));writeBoard(g.sheet,s);SpreadsheetApp.getActiveSpreadsheet().getSheetByName(EVENTS).appendRow([new Date(),g.id,action,team||'',id||'',score(s,0),score(s,1)]);return response({ok:true,game:g.id})}catch(err){return response({ok:false,error:String(err)})}finally{lock.releaseLock()}}
function writeBoard(sh,s){const rows=[['Task'],['Points'],[s.teams[0].name+' · Taken'],['Result'],['Drop'],['Hint'],[s.teams[1].name+' · Taken'],['Result'],['Drop'],['Hint'],['Owner']];for(let n=1;n<=43;n++){const x=s.territories[n-1];rows[0].push(n);rows[1].push(points(n));for(let i=0;i<2;i++){const t=s.teams[i],r=2+i*4;rows[r].push(t.cards.includes(n)?'☑':'');rows[r+1].push(t.results[n]||'—');rows[r+2].push(t.failed.includes(n)?'☑':'');rows[r+3].push(t.hinted.includes(n)?'☑':'')}rows[10].push(x.owner?s.teams[x.owner-1].name:x.blocked?'Blocked':'')}
sh.getRange(4,1,11,44).setValues(rows);sh.getRange('A16:B19').setValues([['Team','Score'],[s.teams[0].name,score(s,0)],[s.teams[1].name,score(s,1)],['Phase',s.phase]]);sh.setFrozenRows(5);sh.setFrozenColumns(1);sh.getRange(4,1,11,1).setBackground('#dce5ea').setFontWeight('bold');sh.getRange(4,2,1,43).setFontWeight('bold');for(let n=1;n<=43;n++){const x=s.territories[n-1],color=x.owner===1?'#f9c99e':x.owner===2?'#bce4bf':x.blocked?'#c8cdd1':n===43?'#f4e4bc':n<=27?'#e6d3b7':'#d4d4d4';sh.getRange(4,n+1,11,1).setBackground(color)}sh.getRange(16,1,1,2).setFontWeight('bold')}
